# Salin ke .env untuk development lokal. Jangan isi secret sungguhan di file ini,
# dan jangan pernah commit file .env (sudah ada di .gitignore).

STUDIO_DATA_DIR=data
STUDIO_CONFIG_DIR=config
# Actor yang boleh memutuskan gate & mengaktifkan anggaran (pisahkan dengan koma).
# Format: cli:<nama> atau telegram:<user_id_numerik>
# Contoh dengan Telegram: STUDIO_OWNER_IDS=cli:owner,telegram:123456789
STUDIO_OWNER_IDS=cli:owner
STUDIO_LOG_LEVEL=INFO

# Kill switch provider berbayar. Fase 1–3: harus false (nilai true ditolak saat start).
PAID_PROVIDERS_ENABLED=false

# --- Telegram (Fase 3) -------------------------------------------------------------
# Token dari @BotFather. Isi di .env lokal Anda saja (atau environment server), JANGAN di sini.
STUDIO_TELEGRAM_BOT_TOKEN=
# Masa berlaku tombol aksi sekali pakai (menit). Tidak pernah melebihi masa approval.
STUDIO_ACTION_TTL_MINUTES=360
# Langkah percakapan (misal menunggu catatan revisi) kedaluwarsa setelah ini (menit).
STUDIO_CONVERSATION_STEP_TTL_MINUTES=30
# Interval cek outbox notifikasi saat sepi (detik).
STUDIO_NOTIFY_IDLE_SECONDS=10
# true = worker job ikut berjalan di proses bot (thread terpisah). false = jalankan
# `uv run studio worker run --loop` di proses lain.
STUDIO_TELEGRAM_RUN_WORKER=true
# Pemrosesan update tahan crash (ADR-0013): lease pemroses update (detik) & jatah percobaan.
STUDIO_UPDATE_LEASE_SECONDS=30
STUDIO_UPDATE_MAX_ATTEMPTS=5
