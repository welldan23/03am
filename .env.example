# Salin ke .env untuk development lokal. Jangan isi secret sungguhan di file ini.

STUDIO_DATA_DIR=data
STUDIO_CONFIG_DIR=config
# Actor yang boleh memutuskan gate & mengaktifkan anggaran (pisahkan dengan koma).
# Format: cli:<nama> atau telegram:<user_id>
STUDIO_OWNER_IDS=cli:owner
STUDIO_LOG_LEVEL=INFO

# Kill switch provider berbayar. Fase 1: harus false (nilai true ditolak saat start).
PAID_PROVIDERS_ENABLED=false
